# Massive Economy API Configuration
# Optional: Set this to your Massive API key to fetch full yield curve data and thematic/crypto details.
# If not set, the script will fall back to yfinance + FRED.
MASSIVE_API_KEY=

# Cloudflare Worker deployment (required by `npm run deploy:cloudflare`)
# Create an API token with permission to edit Cloudflare Workers.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Comma-separated browser origins allowed to call the deployed Worker API.
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=https://stockmarket-dashboard.com,http://localhost:5173,http://127.0.0.1:5173

# Optional frontend base path. Defaults to /market-dashboard/; the Cloudflare
# build overrides this with /.
# VITE_BASE_PATH=/example-subpath/

# Backend override for standalone Vite development or subpath builds.
# Root production builds on Cloudflare use their own origin automatically.
# VITE_BACKEND_API_URL=http://localhost:8787

# Live price refresh (Yahoo Finance overlay when LIVE is enabled)
# VITE_LIVE_DATA_REFRESH_MS=1000
# VITE_LIVE_DATA_IDLE_RETRY_MS=2000

# Settings sync build safety check
# VITE_ENABLE_BUILD_VERSION_CHECK=true

# Backend used by scripts/fetch_data.py for authoritative Yahoo quote snapshots.
# MARKET_DATA_API_URL=https://market-dashboard.florian-trippel.workers.dev

# Local Fetch Tuning / Rate Limit Throttling
# Adjust these if you encounter Yahoo Finance API rate limits.
# YF_BATCH_SIZE=25
# YF_BATCH_PAUSE=1.0
# YF_INFO_PAUSE=0.3
# YF_HOLDINGS_PAUSE=0.4

# Firebase (optional — enables Google sign-in and cloud settings sync)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
